# 复制为 .env 并填入真实值（.env 已被 gitignore，不要提交）
DASHSCOPE_API_KEY=sk-xxxx
# 公有云 DashScope 兼容端点；MaaS 专属部署端点结构不同（不含 /api/v1），按需替换
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 识票用视觉/omni 模型，问答用对话模型（按账号实际授权与免费额度选择）
MODEL_VISION=qwen3.5-omni-plus
MODEL_CHAT=qwen3.8-max
EMBEDDING_MODEL=qwen3.7-text-embedding
# 验真提供方：mock（默认）| 未来可扩展 baiwang / nuonuo
VERIFY_PROVIDER=mock
# 报销审批流程提供方：mock（默认，本地打桩模拟提交）| feishu（需配置下方飞书凭证）
EXPENSE_FLOW_PROVIDER=mock
# 飞书自建应用凭证（feishu 提供方使用）：app_id/secret 在飞书开放平台应用页获取，
# approval_code 在飞书后台「审批管理」对应审批定义的 URL/接口信息中获取
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APPROVAL_CODE=
# PostgreSQL (pgvector)：知识库 RAG 与长期记忆存储
PG_DSN=postgresql://invoice:invoice@localhost:5432/invoice_agent
